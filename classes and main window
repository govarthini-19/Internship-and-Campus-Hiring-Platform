import tkinter as tk
from tkinter import messagebox
class Student:
    def __init__(self, name, skills):
        self.name = name
        self.skills = skills
class Company:
    def __init__(self, name, role, skills):
        self.name = name
        self.role = role
        self.skills = skills
class HiringPlatform:
    def __init__(self, root):
        self.root = root
        self.root.title("Campus Hiring Platform")
        self.root.geometry("500x500")
        self.students = []
        self.jobs = []
        tk.Label(root, text="INTERNSHIP & CAMPUS HIRING",
                 font=("Arial", 18, "bold")).pack(pady=20)
        tk.Button(root, text="Student Registration",
                  command=self.register).pack(pady=8)
        tk.Button(root, text="Post Internship",
                  command=self.post_job).pack(pady=8)
        tk.Button(root, text="View Opportunities",
                  command=self.view_jobs).pack(pady=8)
