import tkinter as tk
from tkinter import messagebox
class Student:
    def __init__(self, name, skills):
        self.name = name
        self.skills = skills
class Company:
    def __init__(self, name, role, skills):
        self.name = name
        self.role = role
        self.skills = skills
class HiringPlatform:
    def __init__(self, root):
        self.root = root
        self.root.title("Campus Hiring Platform")
        self.root.geometry("500x500")
        self.students = []
        self.jobs = []
        tk.Label(root, text="INTERNSHIP & CAMPUS HIRING",
                 font=("Arial", 18, "bold")).pack(pady=20)
        tk.Button(root, text="Student Registration",
                  command=self.register).pack(pady=8)
        tk.Button(root, text="Post Internship",
                  command=self.post_job).pack(pady=8)
        tk.Button(root, text="View Opportunities",
                  command=self.view_jobs).pack(pady=8)
def register(self):
        win = tk.Toplevel(self.root)
        win.title("Student Registration")

        tk.Label(win, text="Name").pack()
        name = tk.Entry(win)
        name.pack()

        tk.Label(win, text="Skills").pack()
        skills = tk.Entry(win)
        skills.pack()

        def save():
            if name.get() and skills.get():
                self.students.append(
                    Student(name.get(),
                            skills.get().lower().split(","))
                )
                messagebox.showinfo(
                    "Success", "Registration Successful")
                win.destroy()
            else:
                messagebox.showerror(
                    "Error", "Enter all details")

        tk.Button(win, text="Register",
                  command=save).pack(pady=10)
def register(self):
        win = tk.Toplevel(self.root)
        win.title("Student Registration")

        tk.Label(win, text="Name").pack()
        name = tk.Entry(win)
        name.pack()

        tk.Label(win, text="Skills").pack()
        skills = tk.Entry(win)
        skills.pack()

        def save():
            if name.get() and skills.get():
                self.students.append(
                    Student(name.get(),
                            skills.get().lower().split(","))
                )
                messagebox.showinfo(
                    "Success", "Registration Successful")
                win.destroy()
            else:
                messagebox.showerror(
                    "Error", "Enter all details")

        tk.Button(win, text="Register",
                  command=save).pack(pady=10)

    def post_job(self):
        win = tk.Toplevel(self.root)
        win.title("Post Internship")

        labels = ["Company", "Role", "Required Skills"]
        entries = []

        for label in labels:
            tk.Label(win, text=label).pack()
            e = tk.Entry(win)
            e.pack()
            entries.append(e)

        def post():
            if all(e.get() for e in entries):
                self.jobs.append(
                    Company(entries[0].get(),
                            entries[1].get(),
                            entries[2].get().lower().split(","))
                )
                messagebox.showinfo(
                    "Success", "Internship Posted")
                win.destroy()

        tk.Button(win, text="Post",
                  command=post).pack(pady=10)
def view_jobs(self):
        win = tk.Toplevel(self.root)
        win.title("Available Opportunities")
        win.geometry("450x400")

        for job in self.jobs:
            skills = ", ".join(job.skills)
            text = f"{job.name} | {job.role} | Skills: {skills}"

            tk.Label(win, text=text).pack(pady=5)

            tk.Button(win, text="Apply",
                      command=lambda j=job:
                      self.apply(j)).pack()

    def apply(self, job):
        if not self.students:
            messagebox.showwarning(
                "Warning", "Register as student first")
            return

        student = self.students[-1]
        required = set(job.skills)
        candidate = set(student.skills)

        match = len(required & candidate)

        if match > 0:
            messagebox.showinfo(
                "Application",
                f"{student.name} applied for {job.role}\n"
                f"Skill Match: {match}/{len(required)}"
            )
        else:
            messagebox.showwarning(
                "Application",
                "Skills do not match this opportunity"
            )

root = tk.Tk()
app = HiringPlatform(root)
root.mainloop()

    
